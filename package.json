{
  "name": "mews",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run cf:typegen && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5197 --strictPort",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8797 --var LOCAL_TEST_SIGN_IN:true --var APP_ORIGIN:http://127.0.0.1:5197",
    "local:setup": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seeds/local.sql",
    "test:auth": "node --test tests/auth/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run cf:typegen && tsc -b",
    "cf:typegen": "wrangler types worker/worker-configuration.d.ts --env-interface WorkerBindings",
    "preview": "vite preview --host 127.0.0.1 --port 4197 --strictPort",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --ci",
    "build-storybook": "storybook build",
    "test:map": "node --test tests/unit/map-data.test.ts tests/unit/map-motion.test.ts",
    "test:ui": "playwright test",
    "validate:ui": "npm run typecheck && npm run test:ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@mapbox/unitbezier": "^1.0.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-doctor": "^0.9.22",
    "shadcn": "4.23.0",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
