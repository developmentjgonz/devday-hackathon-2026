{
  "name": "devday-js-2026",
  "account_id": "d4501cb4c3a0ec6b4b67b051d83d3a30",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devday-js-2026-db",
      "database_id": "5e49e8ba-625a-4954-9ebc-10d7f3100b90"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "devday-js-2026-uploads"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_REPORT_RATE_LIMITER",
      "namespace_id": "9147270630",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "DEMO_ADMIN_RATE_LIMITER",
      "namespace_id": "9147270629",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
